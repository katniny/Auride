// the db rules for auride
{
    "rules": {
        "DONOTMODIFY": {
            ".read": false,
            ".write": false
        },
        "notes": {
            ".read": false,
            ".write": false
        },
        "users": {
            "$uid": {
                // TODO: update permissions to be false.. media uploading has to be migrated to the
                // server-side soon.
                "pfp": {
                    ".read": "auth !== null && auth.uid === $uid",
                    ".write": "auth !== null && auth.uid === $uid"
                },
                "banner": {
                    ".read": "auth !== null && auth.uid === $uid",
                    ".write": "auth !== null && auth.uid === $uid"
                },
                "favorites": {
                    ".read": false,
                    ".write": false
                },
                "notifications": {
                    ".read": false,
                    ".write": false,
                    "unread": {
                        ".write": false,
                        ".read": "auth !== null && auth.uid === $uid"
                    }
                },
                "$other": {
                    ".read": false,
                    ".write": false
                }
            }
        },
        "dms": {
            ".read": false,
            ".write": false
        },
        "verificationRequest": {
            ".read": false,
            ".write": false
        },
        "reports": {
            ".read": false,
            ".write": false
        },
        "taken-usernames": {
            ".read": false,
            ".write": false
        },
        "themes": {
            ".read": false,
            ".write": false
        },
        "playlists": {
            ".read": false,
            ".write": false
        }
    }
}