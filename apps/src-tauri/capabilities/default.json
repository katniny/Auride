{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:10000/**"
        },
        {
          "url": "https://canary.api.auride.xyz/**"
        },
        {
          "url": "https://stable.api.auride.xyz/**"
        }
      ]
    }
  ]
}